{
  "name": "metalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probability markets on Defifa.",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3020",
    "dev:live": "METALOG_DEV_API=https://metalog.money next dev --webpack --hostname 127.0.0.1 --port 3020",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser:lifecycle": "playwright test --config playwright.lifecycle.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "6.3.1",
    "@me.jango/signa": "0.5.0",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/core": "3.6.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@playwright/test": "1.62.1",
    "@solace-fi/hydrate": "0.1.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "eslint": "10.7.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  }
}
